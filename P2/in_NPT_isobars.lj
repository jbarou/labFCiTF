
## =====================================
## Protocol d'isobares (fluid LJ)
## =====================================
## LLegeix P per linia de comandes
## E.g.:
## lmp -var P 0.10 -in in_NVT_isobars.lj
##
## ----------------------------------------------------------------------------------------------------------
## =====================================                                                                    #
## 0) Declaració de variables d'entrada                                                                     #
## =====================================                                                                    #
## MODIFICA aquí les variables que consideris necesaries per les teves simulacions                          #
                                                                                                            #
# ---- mida del sistema                                                                                     #
variable        Nx     equal 5 # n de columnes de particules en x y i z                                     #
                                                                                                            #
# ---- variables de la rampa de densitat. (explora d'altes a baixes)                                        #
variable        Thi equal 1.3         # temperatura superior (inici i fi)                                   #
variable        Tlo equal 0.9         # temperatura inferior                                                #
variable        dT  equal 0.01        # pas de temperature                                                  #
                                                                                                            #
# ---- variables de temps de termalització i producció de dades                                             #
variable        Nequil_hi equal 10000   # N. de passes d'int. per a termalitzar per primer cop.             #
variable        Nequil    equal 40000   # N. de passes d'int. per a termalitzar després de cada salt drho.  #
variable        Nprod     equal 10000   # N. de passes durant les quals pendrem mesures.                    #
variable        NAveStep  equal 200     # Cada quants passos de temps prenem mesures                        #
                                                                                                            #
# ---- llavor de la conf. inicial de velocitats                                                             #
variable        vSeed     equal 12345  # llavor inicial per definir les velocitats com aleatories.          #
                                                                                                            #
## NO MODIFIQUIES RES MÉS A PARTIR D'AQUESTA LÍNIA                                                          #
## ----------------------------------------------------------------------------------------------------------
## =====================================
## 1) Càlcul de variables auxiliars
## =====================================

# numbre de particules
variable Ntot equal ${Nx}*${Nx}*${Nx}

# nombre de punts de temperatura
variable nT equal floor((${Thi}-${Tlo})/${dT})+1

# nombre de valors emprats per el promig
variable NAveRep equal floor(${Nprod}/${NAveStep})

# index del loop
variable i loop ${nT}


## =====================================
## 2) Declaració d'arxius de sortida
## =====================================
## Crea i escriu als arxius de sortida (PROMITJOS DE MESURES TERMODINÀMIQUES)



# clear file IF previously used


variable dir  string thermo_NPT_isoP
variable outf string thermo_NPT_isoP/avg_N${Ntot}P${P}.dat


# crea el directori i borra l'arxiu si ja existeix
shell mkdir ${dir}
shell rm -f ${outf}

print "#T_fixed    P_fixed   Tavg    Tvar    Pavg    Pvar    Ravg    Rvar    Uavg   Uvar    Kavg    Kvar    Eavg    Evar  NaveRep" append ${outf}



# =====================================
# 3) Isobaric cooling protocol (LJ fluid)
# =====================================

units           lj
dimension       3
boundary        p p p
atom_style      atomic




# =====================================
# 4) System setup
# =====================================


# ---------- System ----------
lattice         fcc 0.05
region          box block 0 ${Nx} 0 ${Nx} 0 ${Nx}
create_box      1 box
create_atoms    1 box
mass            1 1.0

pair_style      lj/cut 2.5
pair_modify shift yes
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 5

timestep        0.005

# ---------- Initial velocities ----------
velocity        all create ${Thi} ${vSeed} mom yes dist gaussian

# =====================================
# 5) High-T thermalization (NO OUTPUT)
# =====================================

fix             npt_hi all npt temp ${Thi} ${Thi} 1.0 iso ${P} ${P} 10.0

thermo          0
run             ${Nequil_hi}
unfix           npt_hi

# =====================================
# 6) Loop isobaric de refredament
# =====================================

variable i loop ${nT}

label           loop_Tdown


variable T equal ${Thi}-(${i}-1)*${dT}

# =====================================
# 6.1) Simulació DM
# =====================================

print " "
print " -------------------------------------------------------------"
print " =+=+=+=+=+=+= P = ${P} Running at T = ${T} =+=+=+=+=+=+=+=+"
print " -------------------------------------------------------------"
print " "
print " ## Averaging m=${NAveRep} every ${NAveStep} steps"
print " "
print " "

# --- NPT at current temperature ---
fix             npt all npt temp ${T} ${T} 1.0 iso ${P} ${P} 10.0

# --- Equilibration ---
thermo          0
run             ${Nequil}

# --- Production ---
reset_timestep  0

thermo_style custom step temp pe ke etotal press density


# =====================================
# 6.2) Sortida de variables
# =====================================

variable av_dens equal density
variable av_pe   equal pe 
variable av_ke   equal ke 
variable av_et   equal ke+pe

variable av_temp2 equal temp*temp
variable av_press2 equal press*density
variable av_dens2 equal density*density
variable av_pe2   equal pe*pe 
variable av_ke2   equal ke*ke
variable av_et2   equal (ke+pe)*(ke+pe)




fix thermo_avg all ave/time ${NAveStep} ${NAveRep} ${Nprod} c_thermo_temp c_thermo_press v_av_dens v_av_pe v_av_ke v_av_et

fix thermo_avg2 all ave/time ${NAveStep} ${NAveRep} ${Nprod} v_av_temp2 v_av_press2 v_av_dens2 v_av_pe2 v_av_ke2 v_av_et2




run             ${Nprod}


variable Tavg equal f_thermo_avg[1]
variable Pavg equal f_thermo_avg[2]
variable Ravg equal f_thermo_avg[3]
variable Uavg equal f_thermo_avg[4]
variable Kavg equal f_thermo_avg[5]
variable Eavg equal f_thermo_avg[6]



variable Tvar equal f_thermo_avg2[1]-f_thermo_avg[1]*f_thermo_avg[1]
variable Pvar equal f_thermo_avg2[2]-f_thermo_avg[2]*f_thermo_avg[2]
variable Rvar equal f_thermo_avg2[3]-f_thermo_avg[3]*f_thermo_avg[3]
variable Uvar equal f_thermo_avg2[4]-f_thermo_avg[4]*f_thermo_avg[4]
variable Kvar equal f_thermo_avg2[5]-f_thermo_avg[5]*f_thermo_avg[5]
variable Evar equal f_thermo_avg2[6]-f_thermo_avg[6]*f_thermo_avg[6]


print "${T} ${P} ${Tavg} ${Tvar} ${Pavg} ${Pvar} ${Ravg} ${Rvar} ${Uavg} ${Uvar} ${Kavg} ${Kvar} ${Eavg} ${Evar} ${NAveRep}" append ${outf}

# =====================================
# 6.3) Canvi de T i sortida del loop
# =====================================

# --- Cleanup ---
unfix           thermo_avg
unfix           thermo_avg2
unfix npt

next            i
jump            SELF loop_Tdown




# =====================================
# 7) Loop isobaric d'escalfament
# =====================================

variable i loop ${nT}

label           loop_Tup


variable T equal ${Tlo}+(${i}-1)*${dT}


# =====================================
# 7.1) Simulació DM
# =====================================


print " "
print " -------------------------------------------------------------"
print " =+=+=+=+=+=+= P = ${P} Running at T = ${T} =+=+=+=+=+=+=+=+"
print " -------------------------------------------------------------"
print " "
print " ## Averaging m=${NAveRep} every ${NAveStep} steps"
print " "
print " "

# --- NPT at current temperature ---
fix             npt all npt temp ${T} ${T} 1.0 iso ${P} ${P} 10.0

# --- Equilibration ---
thermo          0
run             ${Nequil}

# --- Production ---
reset_timestep  0

thermo_style custom step temp pe ke etotal press density



# =====================================
# 7.2) Sortida de variables
# =====================================

variable av_dens equal density
variable av_pe   equal pe 
variable av_ke   equal ke 
variable av_et   equal ke+pe

variable av_temp2 equal temp*temp
variable av_press2 equal press*density
variable av_dens2 equal density*density
variable av_pe2   equal pe*pe 
variable av_ke2   equal ke*ke
variable av_et2   equal (ke+pe)*(ke+pe)




fix thermo_avg all ave/time ${NAveStep} ${NAveRep} ${Nprod} c_thermo_temp c_thermo_press v_av_dens v_av_pe v_av_ke v_av_et

fix thermo_avg2 all ave/time ${NAveStep} ${NAveRep} ${Nprod} v_av_temp2 v_av_press2 v_av_dens2 v_av_pe2 v_av_ke2 v_av_et2




run             ${Nprod}


variable Tavg equal f_thermo_avg[1]
variable Pavg equal f_thermo_avg[2]
variable Ravg equal f_thermo_avg[3]
variable Uavg equal f_thermo_avg[4]
variable Kavg equal f_thermo_avg[5]
variable Eavg equal f_thermo_avg[6]



variable Tvar equal f_thermo_avg2[1]-f_thermo_avg[1]*f_thermo_avg[1]
variable Pvar equal f_thermo_avg2[2]-f_thermo_avg[2]*f_thermo_avg[2]
variable Rvar equal f_thermo_avg2[3]-f_thermo_avg[3]*f_thermo_avg[3]
variable Uvar equal f_thermo_avg2[4]-f_thermo_avg[4]*f_thermo_avg[4]
variable Kvar equal f_thermo_avg2[5]-f_thermo_avg[5]*f_thermo_avg[5]
variable Evar equal f_thermo_avg2[6]-f_thermo_avg[6]*f_thermo_avg[6]


print "${T} ${P} ${Tavg} ${Tvar} ${Pavg} ${Pvar} ${Ravg} ${Rvar} ${Uavg} ${Uvar} ${Kavg} ${Kvar} ${Eavg} ${Evar} ${NAveRep}" append ${outf}


# =====================================
# 7.3) Canvi de T i sortida del loop
# =====================================

# --- Cleanup ---
unfix           thermo_avg
unfix           thermo_avg2
unfix npt

next            i
jump            SELF loop_Tup


