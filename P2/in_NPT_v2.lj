# --- INPUT VARIABLES ---

variable Tfix   equal 1.0
#variable rho   equal 0.8442
variable Pfix    equal 0.1
variable Nx     equal 8
variable Nz     equal 20
variable nTime  equal 60000
variable dtPos  equal 500
variable dtTher equal 500



# --- SYSTEM SETUP ---
units lj
atom_style atomic
boundary p p p

#lattice fcc ${rho}
lattice fcc 0.3
region box block 0 ${Nx} 0 ${Nx} 0 ${Nz}
create_box 1 box
create_atoms 1 box
mass 1 1.0



pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5

neighbor 0.3 bin
neigh_modify delay 5

# --- INITIALIZE VELOCITIES ---
velocity all create ${Tfix} 12333 mom yes dist gaussian





# --- COMPUTE ENERGIES ---
compute keatom all ke/atom
compute peatom all pe/atom


# --- DUMP ---
dump 1 all custom ${dtPos} particles/traj_T${Tfix}_P${Pfix}_N${Nx}x${Nx}x${Nz}.lammpstrj id type x y z c_keatom c_peatom




# --- INTEGRATOR ---

## Constant volume
# fix 1 all nvt temp ${Tfix} ${Tfix} 1.0

## constant pressure
 fix 1 all npt temp ${Tfix} ${Tfix} 1 iso ${Pfix} ${Pfix} 5.0


# --- USER VARIABLES FOR THERMO ---
#variable stepvar equal step
#variable tempvar equal temp
#variable pevar equal pe
#variable kevar equal ke
#variable etotalvar equal etotal
#variable pressvar equal press
#variable densvar equal density



thermo ${dtTher}
thermo_style custom step temp pe ke etotal press density

variable av_dens equal density
#variable av_pe2 equal temp  ### comprovat que es equivalent 
compute av_pe   all pe 
compute av_ke   all ke 


#fix thermo_ave all ave/time 100 100 10000 c_thermo_press c_thermo_temp density  c_av_pe c_av_ke file thermo_T${Tfix}P${Pfix}.dat


fix thermo_ave all ave/time 100 100 10000 c_thermo_press c_thermo_temp v_av_dens  c_av_pe c_av_ke  file thermo_T${Tfix}P${Pfix}.dat


# --- PRINT THERMO INTO FILE ---
#fix thermo_print all print ${dtTher} "${stepvar} ${tempvar} ${pevar} ${kevar} ${etotalvar} ${pressvar} ${densvar}" file thermo/thermo_T${Tfix}_P${Pfix}_N${Nx}x${Nx}x${Nz}.dat screen no




timestep 0.005
run ${nTime}
