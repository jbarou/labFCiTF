# --- INPUT VARIABLES ---

variable Temp   equal 0.5
#variable rho   equal 0.8442
variable rho    equal 0.1
variable Nx     equal 7
variable iTime  equal 100000
variable dtPos  equal 500
variable dtTher equal 500



variable dir  string thermo_NVT_fix 
variable outf string ${dir}/thermo_T${Temp}_rho${rho}_N${Nx}x${Nx}x${Nx}.dat

# clear file IF previously used
# crea el directori i borra l'arxiu si ja existeix
shell mkdir ${dir}
shell rm -f ${outf}


# --- SYSTEM SETUP ---
units lj
atom_style atomic
boundary p p p

lattice fcc ${rho}
region box block 0 ${Nx} 0 ${Nx} 0 ${Nx}
create_box 1 box
create_atoms 1 box
mass 1 1.0



pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5

neighbor 0.3 bin
neigh_modify delay 5

# --- INITIALIZE VELOCITIES ---
velocity all create ${Temp} 12333 mom yes dist gaussian



#### DOESN´T WORK
## --- Compute RDF ---
#compute my_rdf all rdf 100 5.0
## --- Output RDF to separate file ---
#fix my_rdf all ave/time 100 10 1000 c_rdf_all[*] file rdf_T${Temp}_rho${rho}_N${Nx}x${Nx}x${Nx}.dat mode vector


# --- COMPUTE ENERGIES ---
compute keatom all ke/atom
compute peatom all pe/atom


# --- DUMP ---
dump 1 all custom ${dtPos} traj_T${Temp}_rho${rho}_N${Nx}x${Nx}x${Nx}.lammpstrj id type x y z c_keatom c_peatom




# --- INTEGRATOR ---
fix 1 all nvt temp ${Temp} ${Temp} 1.0



# --- USER VARIABLES FOR THERMO ---
variable stepvar equal step
variable tempvar equal temp
variable pevar equal pe
variable kevar equal ke
variable etotalvar equal etotal
variable pressvar equal press
variable densvar equal density



thermo ${dtTher}
thermo_style custom step temp pe ke etotal press density

# --- PRINT THERMO INTO FILE ---
fix thermo_print all print ${dtTher} "${stepvar} ${tempvar} ${pevar} ${kevar} ${etotalvar} ${pressvar} ${densvar}" file ${outf} screen no




timestep 0.005
run ${iTime}
