units lj
atom_style atomic
boundary p p p



variable Nevery  equal 100
variable Nrepeat equal 100
variable Nfreq   equal 10000

lattice fcc 0.8
region box block 0 10 0 10 0 10
create_box 1 box
create_atoms 1 box

pair_style lj/cut 2.5
pair_modify shift yes
pair_coeff 1 1 1.0 1.0

mass            1 1.0

# ---------- Initial velocities ----------
velocity        all create ${T} 12345 mom yes dist gaussian

fix nvt_hi all nvt temp ${T} ${T} 1.0



compute myTemp all temp
compute myPE   all pe/atom
compute myPress all pressure myTemp

fix thermo_avg all ave/time ${Nevery} ${Nrepeat} ${Nfreq} c_myTemp








run ${Nfreq}
variable Tavg equal f_thermo_avg[1]


#print "T  ${f_thermo_avg[1]}"

print "T  ${Tavg}"
print "T   ${Nevery}"

